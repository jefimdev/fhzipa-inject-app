<UserControl x:Class="FHZIPA.Installer.Views.RequirementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FHZIPA.Installer.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:RequirementsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TextTitle}" Text="{Binding Title}" />

            <TextBlock Style="{StaticResource TextBody}"
                       Margin="0,6,0,0"
                       Text="{Binding Description}" />

            <!-- As verificacoes, em linhas. -->
            <Border Style="{StaticResource InstallerCard}" Margin="0,16,0,0" Padding="4,2">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
                                    <Ellipse x:Name="Ring"
                                             Width="17"
                                             Height="17"
                                             Stroke="{StaticResource BorderHighlightBrush}"
                                             StrokeThickness="1.5"
                                             Fill="Transparent" />
                                    <Path x:Name="Check"
                                          Width="10"
                                          Height="10"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 1,5 L 4,8 L 9,1.5"
                                          Stroke="{StaticResource BackgroundPrimaryBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed" />
                                    <Path x:Name="Cross"
                                          Width="10"
                                          Height="10"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 1.5,1.5 L 8.5,8.5 M 8.5,1.5 L 1.5,8.5"
                                          Stroke="{StaticResource BackgroundPrimaryBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed" />
                                    <Ellipse x:Name="Spinner"
                                             Width="13"
                                             Height="13"
                                             Stroke="{StaticResource AccentRedBrush}"
                                             StrokeThickness="2"
                                             StrokeDashArray="2 3"
                                             Visibility="Collapsed" />
                                </Grid>

                                <TextBlock Grid.Column="1"
                                           Margin="10,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Title}"
                                           FontSize="12.5"
                                           Foreground="{StaticResource TextPrimaryBrush}" />

                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Text="{Binding Detail}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="210" />

                                <Rectangle Grid.Column="0"
                                           Grid.ColumnSpan="3"
                                           Height="1"
                                           Margin="0,15,0,0"
                                           Fill="#18202C" />
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Passed">
                                    <Setter TargetName="Ring" Property="Fill" Value="{StaticResource SuccessGreenBrush}" />
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource SuccessGreenBrush}" />
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter TargetName="Ring" Property="Fill" Value="{StaticResource ErrorRedBrush}" />
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource ErrorRedBrush}" />
                                    <Setter TargetName="Cross" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                    <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                    <Setter TargetName="Ring" Property="Fill" Value="{StaticResource WarningAmberBrush}" />
                                    <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource WarningAmberBrush}" />
                                    <Setter TargetName="Cross" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Cross" Property="Data" Value="M 5,2 L 5,6.5 M 5,8.4 L 5,8.6" />
                                    <Setter TargetName="Cross" Property="Stroke" Value="{StaticResource BackgroundPrimaryBrush}" />
                                    <Setter TargetName="Cross" Property="StrokeThickness" Value="1.6" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <!-- A barra de progresso. -->
        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <Grid>
                <ProgressBar Style="{StaticResource InstallerProgressBar}"
                             Height="7"
                             Value="{Binding DataContext.ProgressPercent, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                             Maximum="100" />
                <TextBlock HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,0,-2"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding DataContext.ProgressPercentText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}"
                    MinWidth="92"
                    Content="{Binding BackText}"
                    Command="{Binding BackCommand}"
                    AutomationProperties.Name="Voltar" />

            <Button Style="{StaticResource SecondaryButton}"
                    MinWidth="92"
                    Margin="8,0,0,0"
                    Content="{Binding CancelText}"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancelar" />
        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="FHZIPA.Installer.Views.DirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FHZIPA.Installer.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DirectoryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Style="{StaticResource TextTitle}" Text="{Binding Title}" />

                <TextBlock Style="{StaticResource TextBody}"
                           Margin="0,6,0,0"
                           Text="{Binding Description}" />

                <!-- O campo do caminho, com o icone de pasta. -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#0B1018"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerField}"
                            Height="34">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Width="15"
                                  Height="15"
                                  Margin="11,0,0,0"
                                  VerticalAlignment="Center"
                                  Data="M 0.5,3 L 0.5,1.5 L 5.5,1.5 L 7,3.5 L 14.5,3.5 L 14.5,13.5 L 0.5,13.5 Z"
                                  Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="1.2"
                                  StrokeLineJoin="Round" />

                            <TextBox Grid.Column="1"
                                     Style="{StaticResource InstallerTextBox}"
                                     Margin="8,0,8,0"
                                     Padding="0"
                                     Height="32"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Pasta de destino" />
                        </Grid>
                    </Border>

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0"
                            MinWidth="92"
                            Content="{Binding BrowseText}"
                            Command="{Binding BrowseCommand}"
                            AutomationProperties.Name="Procurar pasta" />
                </Grid>

                <TextBlock Style="{StaticResource CardBody}"
                           Margin="2,6,0,0"
                           Foreground="{StaticResource ErrorRedBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding PathProblem}"
                           Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />

                <!-- O espaco em disco. -->
                <Border Style="{StaticResource InstallerCard}" Margin="0,16,0,0" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource TextEyebrow}" Text="ESPAÇO NECESSÁRIO" />
                            <TextBlock Style="{StaticResource CardValue}"
                                       Margin="0,5,0,0"
                                       Text="{Binding NeededText}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource TextEyebrow}" Text="ESPAÇO DISPONÍVEL" />
                            <TextBlock Style="{StaticResource CardValue}"
                                       Margin="0,5,0,0"
                                       Text="{Binding AvailableText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Os atalhos. -->
                <Border Style="{StaticResource InstallerCard}" Margin="0,10,0,0" Padding="14,12">
                    <StackPanel>
                        <CheckBox Style="{StaticResource InstallerCheckBox}"
                                  Content="{Binding DesktopShortcutText}"
                                  IsChecked="{Binding CreateDesktopShortcut}"
                                  AutomationProperties.Name="Criar atalho na área de trabalho" />
                        <CheckBox Style="{StaticResource InstallerCheckBox}"
                                  Margin="0,9,0,0"
                                  Content="{Binding StartMenuShortcutText}"
                                  IsChecked="{Binding CreateStartMenuShortcut}"
                                  AutomationProperties.Name="Criar atalho no menu Iniciar" />
                    </StackPanel>
                </Border>

                <!-- A instalacao anterior. -->
                <Border Style="{StaticResource InfoCard}"
                        Margin="0,10,0,0"
                        Visibility="{Binding HasExistingInstall, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}"
                                   Foreground="{StaticResource InfoBlueBrush}"
                                   Text="{Binding ExistingTitle}" />
                        <TextBlock Style="{StaticResource CardBody}"
                                   Margin="0,5,0,0"
                                   Text="{Binding ExistingText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}"
                    MinWidth="92"
                    Content="{Binding BackText}"
                    Command="{Binding BackCommand}"
                    AutomationProperties.Name="Voltar" />

            <Button Style="{StaticResource PrimaryButton}"
                    MinWidth="104"
                    Margin="8,0,0,0"
                    Content="{Binding NextText}"
                    Command="{Binding NextCommand}"
                    AutomationProperties.Name="Avançar" />
        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="FHZIPA.Installer.Views.ErrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FHZIPA.Installer.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ErrorViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="460" Margin="0,6,0,0">

            <!-- O circulo vermelho com o aviso. -->
            <Border Width="62"
                    Height="62"
                    HorizontalAlignment="Left"
                    CornerRadius="31"
                    Background="#2A0B12"
                    BorderBrush="{StaticResource ErrorRedBrush}"
                    BorderThickness="2">
                <Path Width="30"
                      Height="30"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 15,2 L 28,26 L 2,26 Z"
                      Stroke="{StaticResource ErrorRedBrush}"
                      StrokeThickness="2.4"
                      StrokeLineJoin="Round"
                      Fill="Transparent" />
            </Border>

            <TextBlock Style="{StaticResource TextTitle}"
                       Margin="0,16,0,0"
                       FontSize="21"
                       Text="{Binding Title}" />

            <TextBlock Style="{StaticResource TextBody}"
                       Margin="0,7,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding Description}" />

            <!-- O codigo do erro. -->
            <Border Margin="0,14,0,0"
                    Padding="10,5"
                    HorizontalAlignment="Left"
                    CornerRadius="6"
                    Background="{StaticResource SurfaceSecondaryBrush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource TextBodySmall}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding CodeLabel}" />
                    <TextBlock Style="{StaticResource TextBodySmall}"
                               Margin="8,0,0,0"
                               FontFamily="{StaticResource FontMono}"
                               Foreground="{StaticResource ErrorRedBrush}"
                               Text="{Binding CodeText}" />
                </StackPanel>
            </Border>

            <!-- O que a pessoa pode fazer. -->
            <Border Style="{StaticResource InstallerCard}" Margin="0,16,0,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding ActionLabel}" />
                    <TextBlock Style="{StaticResource CardBody}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding ActionText}" />
                </StackPanel>
            </Border>

            <!-- Onde esta o log com o detalhe tecnico. -->
            <Border Style="{StaticResource InstallerCard}" Margin="0,10,0,0" Padding="14,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding LogLabel}" />
                    <TextBlock Style="{StaticResource CardBody}"
                               Margin="0,6,0,0"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="10.5"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{Binding LogText}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

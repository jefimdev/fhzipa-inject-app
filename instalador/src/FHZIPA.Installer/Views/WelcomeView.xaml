<UserControl x:Class="FHZIPA.Installer.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FHZIPA.Installer.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:WelcomeViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- O titulo do produto. -->
                <TextBlock Style="{StaticResource TextTitle}"
                           FontSize="26"
                           FontWeight="Bold">
                    <Run Text="FHZIPA" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Run Text=" INJECT" Foreground="{StaticResource AccentRedBrush}" />
                </TextBlock>

                <TextBlock Style="{StaticResource TextSubtitle}"
                           Margin="0,4,0,0"
                           Text="{Binding Subtitle}" />

                <!-- O aviso importante, em azul. -->
                <Border Style="{StaticResource InfoCard}" Margin="0,18,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Top"
                                CornerRadius="12"
                                Background="#15395F">
                            <Path Width="12"
                                  Height="12"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 6,0.8 A 5.2,5.2 0 1 1 5.99,0.8 Z M 6,8.6 A 0.9,0.9 0 1 1 5.99,8.6 Z M 5.3,3 L 6.3,3 L 6.3,6.2 L 5.3,6.2 Z"
                                  Fill="{StaticResource InfoBlueBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                            <TextBlock Style="{StaticResource CardTitle}"
                                       Text="{Binding InfoTitle}" />
                            <TextBlock Style="{StaticResource CardBody}"
                                       Margin="0,6,0,0"
                                       Text="{Binding InfoBody}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- O atencao, em vermelho. -->
                <Border Style="{StaticResource WarningCard}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Top"
                                CornerRadius="12"
                                Background="#5C1226">
                            <Path Width="13"
                                  Height="13"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 6.5,0.8 L 12.6,11.6 L 0.4,11.6 Z M 5.9,4.4 L 7.1,4.4 L 7.1,7.6 L 5.9,7.6 Z M 5.9,8.6 L 7.1,8.6 L 7.1,9.8 L 5.9,9.8 Z"
                                  Fill="{StaticResource AccentRedBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="11,0,0,0">
                            <TextBlock Style="{StaticResource CardTitle}"
                                       Foreground="#FF6B84"
                                       Text="{Binding WarningTitle}" />
                            <TextBlock Style="{StaticResource CardBody}"
                                       Margin="0,6,0,0"
                                       Text="{Binding WarningBody}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- As acoes. -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Style="{StaticResource PrimaryButton}"
                    MinWidth="132"
                    Command="{Binding NextCommand}"
                    AutomationProperties.Name="Instalar">
                <StackPanel Orientation="Horizontal">
                    <Path Width="13"
                          Height="13"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          Data="M 6.5,0.5 L 6.5,8 M 2.5,4.8 L 6.5,8.8 L 10.5,4.8 M 0.5,11 L 12.5,11"
                          Stroke="#FFFFFFFF"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                    <TextBlock Text="{Binding InstallText}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource SecondaryButton}"
                    MinWidth="96"
                    Margin="8,0,0,0"
                    Content="{Binding CancelText}"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancelar" />
        </StackPanel>
    </Grid>
</UserControl>

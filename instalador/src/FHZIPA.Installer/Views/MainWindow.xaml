<Window x:Class="FHZIPA.Installer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:FHZIPA.Installer.ViewModels"
        xmlns:ctrl="clr-namespace:FHZIPA.Installer.Controls"
        Title="Instalação do FHZIPA INJECT"
        Width="760"
        Height="520"
        MinWidth="680"
        MinHeight="470"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="#080B12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- ================================================================= -->
    <!-- Camadas do fundo                                                   -->
    <!-- ================================================================= -->
    <Grid x:Name="RootGrid" Background="#080B12">

        <!-- Camada 2: brilho radial escuro. -->
        <Ellipse Width="820"
                 Height="620"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Fill="{StaticResource BackgroundGlowGradient}" />

        <!-- Camada 3: curvas vermelhas decorativas. -->
        <Path Data="M 1000,0 L 1000,190 C 880,265 760,120 620,205 C 500,275 430,180 300,55 L 300,0 Z"
              Fill="#1FFF1744"
              Stretch="Fill"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" />

        <Path Data="M 0,600 L 0,430 C 150,300 250,480 430,385 C 610,290 700,430 1000,250 L 1000,600 Z"
              Fill="#1CFF1744"
              Stretch="Fill"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch" />

        <!-- Camada 4: o contorno luminoso das curvas. -->
        <Path Data="M 0,430 C 150,300 250,480 430,385 C 610,290 700,430 1000,250"
              Stroke="#59FF1744"
              StrokeThickness="1.4"
              Stretch="Fill"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Opacity="0.5" />

        <!-- Camada 5: a iluminacao do canto inferior esquerdo. -->
        <Ellipse Width="420"
                 Height="300"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-120,-60,0,0"
                 Fill="{StaticResource PanelGlowGradient}"
                 Opacity="0.28" />

        <!-- Camada 6: a sobreposicao escura, para o texto ficar legivel. -->
        <Rectangle Fill="{StaticResource VignetteGradient}" />

        <!-- ================================================================= -->
        <!-- A janela propriamente dita                                        -->
        <!-- ================================================================= -->
        <Border CornerRadius="14"
                BorderBrush="#1C2432"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ============================================================= -->
                <!-- Barra de titulo                                               -->
                <!-- ============================================================= -->
                <Border Grid.Row="0"
                        Background="#CC0B0F18"
                        BorderBrush="#1A2230"
                        BorderThickness="0,0,0,1"
                        CornerRadius="14,14,0,0"
                        MouseLeftButtonDown="OnTitleBarMouseDown">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Restaurar" Click="OnMaximizeClick" />
                            <Separator />
                            <MenuItem Header="Minimizar" Click="OnMinimizeClick" />
                            <MenuItem Header="Maximizar" Click="OnMaximizeClick" />
                            <Separator />
                            <MenuItem Header="Fechar" Click="OnCloseClick" />
                        </ContextMenu>
                    </Border.ContextMenu>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- A marca pequena, identica a do painel. -->
                        <Border Grid.Column="0"
                                Width="18"
                                Height="18"
                                Margin="12,0,0,0"
                                CornerRadius="5"
                                Background="{StaticResource LogoGradient}"
                                VerticalAlignment="Center">
                            <Path Width="11"
                                  Height="11"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 5.5,1.5 L 5.5,7 M 3,5 L 5.5,7.6 L 8,5 M 1.5,9.5 L 9.5,9.5"
                                  Stroke="#FFFFFFFF"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Border>

                        <TextBlock Grid.Column="1"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding WindowTitle}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,6,0">
                            <Button Style="{StaticResource IconButton}"
                                    Click="OnMinimizeClick"
                                    ToolTip="Minimizar"
                                    AutomationProperties.Name="Minimizar">
                                <Path Data="M 0,5 L 9,5"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Button>

                            <Button x:Name="MaximizeButton"
                                    Style="{StaticResource IconButton}"
                                    Click="OnMaximizeClick"
                                    ToolTip="Maximizar"
                                    AutomationProperties.Name="Maximizar">
                                <Path Data="M 1.5,1.5 L 8.5,1.5 L 8.5,8.5 L 1.5,8.5 Z"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.1"
                                      StrokeLineJoin="Round" />
                            </Button>

                            <Button Style="{StaticResource IconButton}"
                                    Click="OnCloseClick"
                                    ToolTip="Fechar"
                                    AutomationProperties.Name="Fechar">
                                <Path Data="M 2.5,2.5 L 8.5,8.5 M 8.5,2.5 L 2.5,8.5"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================================= -->
                <!-- Aviso do modo de previa                                        -->
                <!-- ============================================================= -->
                <Border Grid.Row="1"
                        Padding="14,7"
                        Background="#33F59E0B"
                        BorderBrush="#66F59E0B"
                        BorderThickness="0,0,0,1"
                        Visibility="{Binding DataContext.IsPreview, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Width="13"
                              Height="13"
                              VerticalAlignment="Center"
                              Data="M 6.5,1 L 12,11.5 L 1,11.5 Z"
                              Stroke="{StaticResource WarningAmberBrush}"
                              StrokeThickness="1.4"
                              StrokeLineJoin="Round"
                              Fill="Transparent" />
                        <TextBlock Style="{StaticResource TextBodySmall}"
                                   Margin="8,0,0,0"
                                   Foreground="{StaticResource WarningAmberBrush}"
                                   Text="{Binding DataContext.PreviewBannerText, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </Border>

                <!-- ============================================================= -->
                <!-- Corpo                                                          -->
                <!-- ============================================================= -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="*" MinWidth="216" MaxWidth="300" />
                        <ColumnDefinition x:Name="RightColumn" Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ Painel lateral ============ -->
                    <Border Grid.Column="0"
                            Background="{StaticResource PanelGradient}"
                            BorderBrush="#1A2230"
                            BorderThickness="0,0,1,0">
                        <Grid ClipToBounds="True">
                            <!-- As curvas do painel. -->
                            <Path Data="M 0,600 L 0,430 C 150,300 250,480 430,385 C 610,290 700,430 1000,250 L 1000,600 Z"
                                  Fill="#40FF1744"
                                  Stretch="Fill"
                                  VerticalAlignment="Bottom"
                                  Height="200"
                                  HorizontalAlignment="Stretch" />

                            <Path Data="M 0,430 C 150,300 250,480 430,385 C 610,290 700,430 1000,250"
                                  Stroke="#73FF1744"
                                  StrokeThickness="1.2"
                                  Stretch="Fill"
                                  VerticalAlignment="Bottom"
                                  Height="200"
                                  HorizontalAlignment="Stretch"
                                  Opacity="0.55" />

                            <Ellipse Width="300"
                                     Height="220"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Bottom"
                                     Margin="-70,-30,0,0"
                                     Fill="{StaticResource PanelGlowGradient}"
                                     Opacity="0.5" />

                            <Grid Margin="18,16,16,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- A marca. -->
                                <ctrl:BrandLogo Grid.Row="0"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top" />

                                <!-- O nome do produto. -->
                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource TextProduct}">
                                        <Run Text="FHZIPA" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Run Text=" INJECT" Foreground="{StaticResource AccentRedBrush}" />
                                    </TextBlock>

                                    <!-- O subtitulo, com espacamento. -->
                                    <TextBlock Style="{StaticResource TextEyebrow}"
                                               Margin="0,5,0,0"
                                               Foreground="#8C99AE"
                                               Text="{Binding BrandSubtitle}" />
                                </StackPanel>

                                <!-- Os destaques, na tela de boas-vindas. -->
                                <ItemsControl Grid.Row="2"
                                              Margin="0,16,0,0"
                                              ItemsSource="{Binding Features}"
                                              Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#14FFFFFF"
                                                    CornerRadius="8"
                                                    Padding="9,7"
                                                    Margin="0,0,0,7">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="13"
                                                          Height="13"
                                                          VerticalAlignment="Top"
                                                          Margin="0,1,0,0"
                                                          Data="M 6.5,0.6 L 11.6,2.2 L 11.6,6.4 C 11.6,9.4 9.2,11.6 6.5,12.6 C 3.8,11.6 1.4,9.4 1.4,6.4 L 1.4,2.2 Z"
                                                          Fill="{StaticResource AccentRedBrush}">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Fill" Value="{StaticResource AccentRedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Icon}" Value="Bolt">
                                                                        <Setter Property="Fill" Value="{StaticResource InfoBlueBrush}" />
                                                                        <Setter Property="Data" Value="M 7.6,0.6 L 2.4,7.4 L 5.8,7.4 L 5.2,12.6 L 10.6,5.6 L 7.2,5.6 Z" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Icon}" Value="Gear">
                                                                        <Setter Property="Fill" Value="{StaticResource WarningAmberBrush}" />
                                                                        <Setter Property="Data" Value="M 6.5,1 L 7.7,1 L 8.1,2.3 L 9.2,3 L 10.4,2.6 L 11.1,4.2 L 10.3,5.2 L 10.3,6.5 L 11.1,7.5 L 10.4,9.1 L 9.2,8.7 L 8.1,9.4 L 7.7,10.7 L 6.5,10.7 L 6.1,9.4 L 5,8.7 L 3.8,9.1 L 3.1,7.5 L 3.9,6.5 L 3.9,5.2 L 3.1,4.2 L 3.8,2.6 L 5,3 L 6.1,2.3 Z" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>

                                                    <StackPanel Margin="9,0,0,0">
                                                        <TextBlock Style="{StaticResource CardTitle}"
                                                                   FontSize="11.5"
                                                                   Text="{Binding Title}" />
                                                        <TextBlock Style="{StaticResource CardBody}"
                                                                   FontSize="10.5"
                                                                   Margin="0,2,0,0"
                                                                   MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                   Text="{Binding Detail}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- As etapas. -->
                                <ScrollViewer Grid.Row="2"
                                              Margin="0,16,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding IsWelcome, Converter={StaticResource InverseBoolToVisibility}}">
                                    <ItemsControl x:Name="StepsHost" ItemsSource="{Binding Steps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="22" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Grid.Column="0" VerticalAlignment="Top">
                                                        <Ellipse x:Name="Ring"
                                                                 Width="15"
                                                                 Height="15"
                                                                 Stroke="{StaticResource BorderHighlightBrush}"
                                                                 StrokeThickness="1.5"
                                                                 Fill="Transparent" />
                                                        <Ellipse x:Name="Dot"
                                                                 Width="7"
                                                                 Height="7"
                                                                 Fill="{StaticResource AccentRedBrush}"
                                                                 Visibility="Collapsed" />
                                                        <Path x:Name="Check"
                                                              Width="9"
                                                              Height="9"
                                                              Data="M 1,4.5 L 3.5,7 L 7.5,1.5"
                                                              Stroke="{StaticResource BackgroundPrimaryBrush}"
                                                              StrokeThickness="1.6"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              Visibility="Collapsed" />
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" Margin="2,0,0,0">
                                                        <TextBlock x:Name="StepTitle"
                                                                   Text="{Binding Title}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource TextMutedBrush}" />
                                                        <TextBlock x:Name="StepStatus"
                                                                   Margin="0,1,0,0"
                                                                   Text="{Binding StatusText}"
                                                                   FontSize="10.5"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   Visibility="Collapsed" />
                                                    </StackPanel>
                                                </Grid>

                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Running">
                                                        <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentRedBrush}" />
                                                        <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                                                        <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="StepTitle" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                        <Setter TargetName="StepTitle" Property="FontWeight" Value="SemiBold" />
                                                        <Setter TargetName="StepStatus" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="StepStatus" Property="Foreground" Value="{StaticResource AccentRedBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Done">
                                                        <Setter TargetName="Ring" Property="Fill" Value="{StaticResource SuccessGreenBrush}" />
                                                        <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource SuccessGreenBrush}" />
                                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="StepTitle" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Setter TargetName="StepStatus" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="StepStatus" Property="Foreground" Value="{StaticResource SuccessGlowBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                        <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource ErrorRedBrush}" />
                                                        <Setter TargetName="StepTitle" Property="Foreground" Value="{StaticResource ErrorRedBrush}" />
                                                        <Setter TargetName="StepStatus" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="StepStatus" Property="Foreground" Value="{StaticResource ErrorRedBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- O rodape do painel. -->
                                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                    <Rectangle Height="1"
                                               Fill="#2A1A22"
                                               Margin="0,0,0,8" />
                                    <TextBlock Style="{StaticResource TextFooter}"
                                               Text="{Binding VersionText}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ============ Painel direito ============ -->
                    <Grid Grid.Column="1" Background="#080B12F2">
                        <ContentControl x:Name="ViewHost"
                                        Content="{Binding CurrentView}"
                                        Margin="22,18,22,12"
                                        Focusable="False" />

                        <!-- O aviso de erro. -->
                        <Border Margin="22,18,22,12"
                                VerticalAlignment="Top"
                                Background="#2A0F14"
                                BorderBrush="#7A1B2E"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerCard}"
                                Padding="14"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}"
                                           Foreground="{StaticResource ErrorRedBrush}"
                                           Text="{Binding Error.Title}" />
                                <TextBlock Style="{StaticResource CardBody}"
                                           Margin="0,6,0,0"
                                           Text="{Binding Error.Description}" />
                                <TextBlock Style="{StaticResource CardBody}"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding Error.Action}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ============================================================= -->
                            </Grid>
        </Border>
    </Grid>
</Window>

<UserControl x:Class="FHZIPA.Installer.Views.FinalizingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FHZIPA.Installer.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:FinalizingViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TextTitle}" Text="{Binding Title}" />

            <TextBlock Style="{StaticResource TextBody}"
                       Margin="0,6,0,0"
                       Text="{Binding Description}" />

            <!-- A barra de progresso. -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0"
                             Style="{StaticResource InstallerProgressBar}"
                             Height="9"
                             Value="{Binding DataContext.ProgressPercent, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                             Maximum="100" />

                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding DataContext.ProgressPercentText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
            </Grid>

            <!-- As verificacoes finais. -->
            <Border Style="{StaticResource InstallerCard}" Margin="0,16,0,0" Padding="4,2">
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="18" Height="18" Margin="0,12,0,0" VerticalAlignment="Top">
                                    <Path x:Name="Gear"
                                          Width="14"
                                          Height="14"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 7,1.6 L 8.3,1.6 L 8.7,3.1 L 9.9,3.8 L 11.3,3.4 L 12.1,5.2 L 11.2,6.3 L 11.2,7.6 L 12.1,8.7 L 11.3,10.5 L 9.9,10.1 L 8.7,10.8 L 8.3,12.3 L 7,12.3 L 6.7,10.8 L 5.5,10.1 L 4.1,10.5 L 3.3,8.7 L 4.2,7.6 L 4.2,6.3 L 3.3,5.2 L 4.1,3.4 L 5.5,3.8 L 6.7,3.1 Z"
                                          Fill="{StaticResource AccentRedBrush}" />
                                    <Path x:Name="Check"
                                          Width="11"
                                          Height="11"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 1,5.5 L 4,8.5 L 9.5,1.5"
                                          Stroke="{StaticResource SuccessGreenBrush}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed" />
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="10,10,0,0">
                                    <TextBlock Style="{StaticResource CardValue}" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource CardBody}"
                                               Margin="0,2,0,0"
                                               Text="{Binding Detail}"
                                               Visibility="{Binding Detail, Converter={StaticResource StringToVisibility}}" />
                                </StackPanel>

                                <Rectangle Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Height="1"
                                           Margin="0,14,0,0"
                                           Fill="#18202C" />
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Passed">
                                    <Setter TargetName="Gear" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter TargetName="Gear" Property="Fill" Value="{StaticResource ErrorRedBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}"
                    MinWidth="92"
                    Content="{Binding CancelText}"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancelar" />
        </StackPanel>
    </Grid>
</UserControl>

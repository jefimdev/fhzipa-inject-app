<UserControl x:Class="FHZIPA.Installer.Views.ComponentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FHZIPA.Installer.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ComponentsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TextTitle}" Text="{Binding Title}" />

            <TextBlock Style="{StaticResource TextBody}"
                       Margin="0,6,0,0"
                       Text="{Binding Description}" />

            <!-- Os componentes. -->
            <Border Style="{StaticResource InstallerCard}" Margin="0,16,0,0" Padding="4,2">
                <ItemsControl ItemsSource="{Binding Components}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- O icone do componente. -->
                                <Border Grid.Column="0"
                                        Width="26"
                                        Height="26"
                                        Margin="0,12,0,0"
                                        VerticalAlignment="Top"
                                        CornerRadius="7"
                                        Background="#1A2432">
                                    <Path Width="14"
                                          Height="14"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 7,1 L 7,9 M 3.5,6 L 7,9.5 L 10.5,6 M 1.5,12.5 L 12.5,12.5"
                                          Stroke="{StaticResource AccentRedBrush}"
                                          StrokeThickness="1.5"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="11,10,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource CardValue}"
                                                   Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource TextEyebrow}"
                                                   Margin="7,2,0,0"
                                                   Text="{Binding DataContext.OptionalText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Visibility="{Binding IsOptional, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource CardBody}"
                                               Margin="0,2,0,0"
                                               Text="{Binding Detail}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="10,13,0,0">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding StatusText}" />

                                    <Grid Margin="8,0,0,0" Width="16" Height="16" VerticalAlignment="Center">
                                        <Ellipse x:Name="Ring"
                                                 Stroke="{StaticResource BorderHighlightBrush}"
                                                 StrokeThickness="1.5"
                                                 Fill="Transparent" />
                                        <Ellipse x:Name="Dot"
                                                 Width="7"
                                                 Height="7"
                                                 Fill="{StaticResource AccentRedBrush}"
                                                 Visibility="Collapsed" />
                                        <Path x:Name="Check"
                                              Width="10"
                                              Height="10"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 1,5 L 4,8 L 9,1.5"
                                              Stroke="{StaticResource SuccessGreenBrush}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Visibility="Collapsed" />
                                        <Path x:Name="Cross"
                                              Width="10"
                                              Height="10"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M 1.5,1.5 L 8.5,8.5 M 8.5,1.5 L 1.5,8.5"
                                              Stroke="{StaticResource ErrorRedBrush}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Visibility="Collapsed" />
                                    </Grid>
                                </StackPanel>

                                <Rectangle Grid.Column="0"
                                           Grid.ColumnSpan="3"
                                           Height="1"
                                           Margin="0,14,0,0"
                                           Fill="#18202C" />
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Installing">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Verifying">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Validating">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Downloading">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Done">
                                    <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Cross" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}"
                    MinWidth="92"
                    Content="{Binding CancelText}"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancelar" />
        </StackPanel>
    </Grid>
</UserControl>

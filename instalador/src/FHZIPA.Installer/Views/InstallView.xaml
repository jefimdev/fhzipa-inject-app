<UserControl x:Class="FHZIPA.Installer.Views.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FHZIPA.Installer.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:InstallViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TextTitle}" Text="{Binding Title}" />

            <TextBlock Style="{StaticResource TextBody}"
                       Margin="0,6,0,0"
                       Text="{Binding Description}" />

            <!-- A barra de progresso. -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0"
                             Style="{StaticResource InstallerProgressBar}"
                             Height="9"
                             Value="{Binding DataContext.ProgressPercent, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                             Maximum="100" />

                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding DataContext.ProgressPercentText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
            </Grid>

            <!-- As operacoes. -->
            <Border Style="{StaticResource InstallerCard}" Margin="0,16,0,0" Padding="14,12">
                <ItemsControl ItemsSource="{Binding Operations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- O ponto do estado. -->
                                <Grid Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                                    <Ellipse x:Name="Dot"
                                             Width="7"
                                             Height="7"
                                             Fill="{StaticResource TextMutedBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                    <Path x:Name="Check"
                                          Width="11"
                                          Height="11"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 1,5.5 L 4,8.5 L 9.5,1.5"
                                          Stroke="{StaticResource SuccessGreenBrush}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed" />
                                </Grid>

                                <TextBlock Grid.Column="1"
                                           Margin="10,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Title}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" />

                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Text="{Binding StatusText}" />
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Running">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentRedBrush}" />
                                    <Setter Property="Tag" TargetName="Dot" Value="running" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Done">
                                    <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource ErrorRedBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}"
                    MinWidth="92"
                    Content="{Binding CancelText}"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancelar" />
        </StackPanel>
    </Grid>
</UserControl>

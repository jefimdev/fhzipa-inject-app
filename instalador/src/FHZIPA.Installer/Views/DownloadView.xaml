<UserControl x:Class="FHZIPA.Installer.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FHZIPA.Installer.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DownloadViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TextTitle}" Text="{Binding Title}" />

            <TextBlock Style="{StaticResource TextBody}"
                       Margin="0,6,0,0"
                       Text="{Binding Description}" />

            <!-- A barra, com a porcentagem a direita. -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Column="0"
                             Style="{StaticResource InstallerProgressBar}"
                             Height="9"
                             Value="{Binding DataContext.ProgressPercent, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                             Maximum="100" />

                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding DataContext.ProgressPercentText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
            </Grid>

            <!-- Os detalhes: arquivo, tamanho, velocidade e tempo. -->
            <Border Style="{StaticResource ProgressCard}" Margin="0,16,0,0" Padding="14,12">
                <StackPanel>
                    <Grid Margin="0,0,0,7">
                        <TextBlock Style="{StaticResource TextBodySmall}"
                                   Text="{Binding FileLabel}" />
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource TextBodySmall}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding FileName}" />
                    </Grid>

                    <Grid Margin="0,0,0,7">
                        <TextBlock Style="{StaticResource TextBodySmall}" Text="Tamanho:" />
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource TextBodySmall}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding SizeText}" />
                    </Grid>

                    <Grid Margin="0,0,0,7">
                        <TextBlock Style="{StaticResource TextBodySmall}" Text="Velocidade:" />
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource TextBodySmall}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding SpeedText}" />
                    </Grid>

                    <Grid>
                        <TextBlock Style="{StaticResource TextBodySmall}" Text="Tempo restante:" />
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource TextBodySmall}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding RemainingText}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}"
                    MinWidth="92"
                    Content="{Binding CancelText}"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancelar" />
        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="FHZIPA.Installer.Views.OpenNowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FHZIPA.Installer.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:OpenNowViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Style="{StaticResource TextTitle}" Text="{Binding Title}" />

                <TextBlock Style="{StaticResource TextBody}"
                           Margin="0,6,0,0"
                           Text="{Binding Description}" />

                <!-- A captura real do aplicativo, dentro de uma moldura. -->
                <Border Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Background="#0B1018"
                        BorderBrush="{StaticResource BorderHighlightBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Effect="{StaticResource CardShadow}">
                    <Grid>
                        <!-- A barra da janela, para parecer uma janela. -->
                        <Grid Height="22" VerticalAlignment="Top" Background="#141B26">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                <Ellipse Width="6" Height="6" Margin="0,0,4,0" Fill="#3A4557" />
                                <Ellipse Width="6" Height="6" Margin="0,0,4,0" Fill="#3A4557" />
                                <Ellipse Width="6" Height="6" Fill="#3A4557" />
                            </StackPanel>

                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="8"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="FHZIPA INJECT" />
                        </Grid>

                        <Image Margin="1,23,1,1"
                               MaxWidth="420"
                               MaxHeight="260"
                               HorizontalAlignment="Left"
                               Source="{Binding PreviewSource}"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource CardBody}"
                           Margin="0,10,0,0"
                           Foreground="{StaticResource WarningAmberBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding LaunchMessage}"
                           Visibility="{Binding HasLaunchMessage, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <CheckBox Style="{StaticResource InstallerCheckBox}"
                      Content="{Binding ShortcutText}"
                      IsChecked="{Binding CreateDesktopShortcut}"
                      AutomationProperties.Name="Criar atalho na área de trabalho" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource PrimaryButton}"
                        MinWidth="130"
                        Content="{Binding OpenNowText}"
                        Command="{Binding OpenNowCommand}"
                        AutomationProperties.Name="Abrir agora" />

                <Button Style="{StaticResource SecondaryButton}"
                        MinWidth="110"
                        Margin="8,0,0,0"
                        Content="{Binding NotNowText}"
                        Command="{Binding NotNowCommand}"
                        AutomationProperties.Name="Agora não" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

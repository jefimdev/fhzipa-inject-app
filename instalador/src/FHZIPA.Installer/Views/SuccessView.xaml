<UserControl x:Class="FHZIPA.Installer.Views.SuccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FHZIPA.Installer.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SuccessViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- O conteudo fica centralizado, como na referencia. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="420">

                <!-- O circulo verde com o check. -->
                <Border Width="76"
                        Height="76"
                        HorizontalAlignment="Center"
                        CornerRadius="38"
                        Background="#0B2418"
                        BorderBrush="{StaticResource SuccessGreenBrush}"
                        BorderThickness="2"
                        Effect="{StaticResource SuccessGlow}">
                    <Path Width="38"
                          Height="38"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 4,19 L 14,29 L 34,7"
                          Stroke="{StaticResource SuccessGreenBrush}"
                          StrokeThickness="4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </Border>

                <TextBlock Style="{StaticResource TextTitle}"
                           Margin="0,20,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="23"
                           Text="{Binding Title}" />

                <TextBlock Style="{StaticResource TextBody}"
                           Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="13"
                           Text="{Binding Body}" />

                <TextBlock Style="{StaticResource TextBodySmall}"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Text="{Binding VersionText}" />

                <TextBlock Style="{StaticResource TextBodySmall}"
                           Margin="0,3,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                   Text="{Binding InstalledText}" />

                <!-- Os botoes. -->
                <Button Style="{StaticResource PrimaryButton}"
                        Margin="0,22,0,0"
                        MinWidth="250"
                        Height="42"
                        HorizontalAlignment="Center"
                        Command="{Binding OpenCommand}"
                        AutomationProperties.Name="Abrir FHZIPA INJECT">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14"
                              Height="14"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Data="M 3,1 L 12,7 L 3,13 Z"
                              Fill="#FFFFFFFF" />
                        <TextBlock FontSize="13" VerticalAlignment="Center" Text="{Binding OpenButtonText}" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SecondaryButton}"
                        Margin="0,10,0,0"
                        MinWidth="250"
                        Height="38"
                        HorizontalAlignment="Center"
                        Content="{Binding FinishButtonText}"
                        Command="{Binding FinishCommand}"
                        AutomationProperties.Name="Concluir" />

                <!-- A confirmacao, no rodape. -->
                <StackPanel Orientation="Horizontal"
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center">
                    <Path Width="13"
                          Height="13"
                          VerticalAlignment="Center"
                          Data="M 1,6.5 L 4.5,10 L 11,1.5"
                          Stroke="{StaticResource SuccessGreenBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                    <TextBlock Style="{StaticResource TextBodySmall}"
                               Margin="7,0,0,0"
                               Foreground="{StaticResource SuccessGlowBrush}"
                               Text="{Binding ConfirmText}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

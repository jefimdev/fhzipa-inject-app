<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <UseWindowsForms>false</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>FHZIPA_INJECT_Setup</AssemblyName>
    <RootNamespace>FHZIPA.Installer</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <!-- As arquiteturas-alvo da publicacao. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <!-- A identidade do produto vem dos metadados reais do projeto. -->
    <Product>FHZIPA INJECT</Product>
    <AssemblyTitle>Instalação do FHZIPA INJECT</AssemblyTitle>
    <AssemblyDescription>Instalador de aplicativos para iPhone.</AssemblyDescription>
    <Company>FHZIPA INJECT</Company>
    <Copyright>Copyright (c) FHZIPA INJECT</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <NeutralLanguage>pt-BR</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationIcon Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- O aplicativo instalado viaja dentro do instalador. -->
    <EmbeddedResource Include="Resources\fhzipa-inject.exe" LogicalName="FHZIPA.Installer.Resources.fhzipa-inject.exe" />
    <!-- O resumo do aplicativo, para a verificacao de integridade. -->
    <EmbeddedResource Include="Resources\payload.sha256" LogicalName="FHZIPA.Installer.Resources.payload.sha256" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <!-- A captura real do aplicativo, mostrada na tela final. -->
    <Resource Include="Assets\app-preview.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="installer.config.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('installer.config.json')" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>

</Project>

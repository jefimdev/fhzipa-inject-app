<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ================================================================== -->
  <!-- Espacamento                                                         -->
  <!-- ================================================================== -->
  <sys:Double x:Key="SpaceExtraSmall" xmlns:sys="clr-namespace:System;assembly=mscorlib">3</sys:Double>
  <sys:Double x:Key="SpaceSmall" xmlns:sys="clr-namespace:System;assembly=mscorlib">6</sys:Double>
  <sys:Double x:Key="SpaceMedium" xmlns:sys="clr-namespace:System;assembly=mscorlib">10</sys:Double>
  <sys:Double x:Key="SpaceNormal" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
  <sys:Double x:Key="SpaceLarge" xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
  <sys:Double x:Key="SpaceExtraLarge" xmlns:sys="clr-namespace:System;assembly=mscorlib">28</sys:Double>
  <sys:Double x:Key="SpaceSection" xmlns:sys="clr-namespace:System;assembly=mscorlib">34</sys:Double>

  <!-- ================================================================== -->
  <!-- Arredondamento                                                     -->
  <!-- ================================================================== -->
  <CornerRadius x:Key="CornerButton">8</CornerRadius>
  <CornerRadius x:Key="CornerField">7</CornerRadius>
  <CornerRadius x:Key="CornerCard">12</CornerRadius>
  <CornerRadius x:Key="CornerPanel">14</CornerRadius>
  <CornerRadius x:Key="CornerWindow">14</CornerRadius>
  <CornerRadius x:Key="CornerLogo">18</CornerRadius>

  <!-- ================================================================== -->
  <!-- Tipografia                                                         -->
  <!-- A janela e compacta, entao a hierarquia foi comprimida: o titulo   -->
  <!-- do produto e grande, o titulo de tela e medio, o texto e pequeno.   -->
  <!-- ================================================================== -->
  <FontFamily x:Key="FontDefault">Segoe UI</FontFamily>
  <FontFamily x:Key="FontDisplay">Segoe UI Semibold</FontFamily>
  <FontFamily x:Key="FontMono">Consolas</FontFamily>

  <sys:Double x:Key="FontSizeProduct" xmlns:sys="clr-namespace:System;assembly=mscorlib">23</sys:Double>
  <sys:Double x:Key="FontSizeTitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
  <sys:Double x:Key="FontSizeSubtitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
  <sys:Double x:Key="FontSizeSection" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
  <sys:Double x:Key="FontSizeBody" xmlns:sys="clr-namespace:System;assembly=mscorlib">12.5</sys:Double>
  <sys:Double x:Key="FontSizeBodySmall" xmlns:sys="clr-namespace:System;assembly=mscorlib">11.5</sys:Double>
  <sys:Double x:Key="FontSizeButton" xmlns:sys="clr-namespace:System;assembly=mscorlib">12.5</sys:Double>
  <sys:Double x:Key="FontSizeFooter" xmlns:sys="clr-namespace:System;assembly=mscorlib">10.5</sys:Double>
  <sys:Double x:Key="FontSizeEyebrow" xmlns:sys="clr-namespace:System;assembly=mscorlib">9.5</sys:Double>

  <Style x:Key="TextProduct" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeProduct}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>

  <Style x:Key="TextTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="TextSubtitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>

  <Style x:Key="TextSection" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSection}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style x:Key="TextBody" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="TextBodySmall" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBodySmall}" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="LineHeight" Value="16" />
  </Style>

  <Style x:Key="TextFooter" TargetType="TextBlock" BasedOn="{StaticResource TextBodySmall}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeFooter}" />
  </Style>

  <!-- O subtitulo espacado: o WPF nao tem espacamento entre letras,   -->
  <!-- entao o espaco entra no proprio texto.                             -->
  <Style x:Key="TextEyebrow" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeEyebrow}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

</ResourceDictionary>

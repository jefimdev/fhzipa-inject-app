<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ================================================================== -->
  <!-- FHZIPA INJECT - paleta de cores                                     -->
  <!-- Nenhuma cor aparece fora deste arquivo.                            -->
  <!-- ================================================================== -->

  <!-- Fundos -->
  <Color x:Key="BackgroundPrimaryColor">#080B12</Color>
  <Color x:Key="BackgroundSecondaryColor">#0D111B</Color>
  <Color x:Key="BackgroundDeepColor">#05070D</Color>
  <Color x:Key="SurfacePrimaryColor">#111827</Color>
  <Color x:Key="SurfaceSecondaryColor">#17212E</Color>
  <Color x:Key="SurfaceElevatedColor">#1B2635</Color>

  <!-- Acento vermelho da marca -->
  <Color x:Key="AccentRedColor">#FF1744</Color>
  <Color x:Key="AccentRedLightColor">#FF335B</Color>
  <Color x:Key="AccentRedDarkColor">#B90028</Color>
  <Color x:Key="AccentRedDeepColor">#71001B</Color>

  <!-- Cores de apoio -->
  <Color x:Key="SuccessGreenColor">#22C55E</Color>
  <Color x:Key="SuccessGlowColor">#16A34A</Color>
  <Color x:Key="InfoBlueColor">#2589FF</Color>
  <Color x:Key="WarningAmberColor">#F59E0B</Color>
  <Color x:Key="ErrorRedColor">#EF4444</Color>

  <!-- Texto -->
  <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
  <Color x:Key="TextSecondaryColor">#94A3B8</Color>
  <Color x:Key="TextMutedColor">#64748B</Color>

  <!-- Bordas -->
  <Color x:Key="BorderDefaultColor">#273244</Color>
  <Color x:Key="BorderHighlightColor">#354258</Color>

  <!-- Desabilitado -->
  <Color x:Key="DisabledBackgroundColor">#27303C</Color>
  <Color x:Key="DisabledForegroundColor">#778190</Color>

  <!-- ================================================================== -->
  <!-- Pinceles solids                                                     -->
  <!-- ================================================================== -->
  <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimaryColor}" />
  <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondaryColor}" />
  <SolidColorBrush x:Key="BackgroundDeepBrush" Color="{StaticResource BackgroundDeepColor}" />
  <SolidColorBrush x:Key="SurfacePrimaryBrush" Color="{StaticResource SurfacePrimaryColor}" />
  <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondaryColor}" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
  <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}" />
  <SolidColorBrush x:Key="AccentRedLightBrush" Color="{StaticResource AccentRedLightColor}" />
  <SolidColorBrush x:Key="AccentRedDarkBrush" Color="{StaticResource AccentRedDarkColor}" />
  <SolidColorBrush x:Key="AccentRedDeepBrush" Color="{StaticResource AccentRedDeepColor}" />
  <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreenColor}" />
  <SolidColorBrush x:Key="SuccessGlowBrush" Color="{StaticResource SuccessGlowColor}" />
  <SolidColorBrush x:Key="InfoBlueBrush" Color="{StaticResource InfoBlueColor}" />
  <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmberColor}" />
  <SolidColorBrush x:Key="ErrorRedBrush" Color="{StaticResource ErrorRedColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderDefaultColor}" />
  <SolidColorBrush x:Key="BorderHighlightBrush" Color="{StaticResource BorderHighlightColor}" />
  <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="{StaticResource DisabledBackgroundColor}" />
  <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{StaticResource DisabledForegroundColor}" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

  <!-- ================================================================== -->
  <!-- Gradientes                                                          -->
  <!-- ================================================================== -->

  <!-- O logo: vermelho vivo no topo, profundo embaixo. -->
  <LinearGradientBrush x:Key="LogoGradient" StartPoint="0.2,0" EndPoint="0.8,1">
    <GradientStop Color="#FF335B" Offset="0" />
    <GradientStop Color="#FF1744" Offset="0.45" />
    <GradientStop Color="#C2002A" Offset="1" />
  </LinearGradientBrush>

  <!-- O botão principal: vermelho luminoso em cima. -->
  <LinearGradientBrush x:Key="ButtonRedGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF3B62" Offset="0" />
    <GradientStop Color="#FF1744" Offset="0.5" />
    <GradientStop Color="#D60029" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="ButtonRedHoverGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FF5A78" Offset="0" />
    <GradientStop Color="#FF2E53" Offset="0.5" />
    <GradientStop Color="#E00034" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="ButtonRedPressedGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E82950" Offset="0" />
    <GradientStop Color="#C2002A" Offset="0.5" />
    <GradientStop Color="#A90026" Offset="1" />
  </LinearGradientBrush>

  <!-- O painel lateral: vinho no topo, preto embaixo. -->
  <LinearGradientBrush x:Key="PanelGradient" StartPoint="0.15,0" EndPoint="0.85,1">
    <GradientStop Color="#2A0410" Offset="0" />
    <GradientStop Color="#170510" Offset="0.35" />
    <GradientStop Color="#0B0A14" Offset="0.72" />
    <GradientStop Color="#07080F" Offset="1" />
  </LinearGradientBrush>

  <!-- A faixa vermelha que atravessa o painel. -->
  <LinearGradientBrush x:Key="PanelRedBandGradient" StartPoint="0,0" EndPoint="1,0.4">
    <GradientStop Color="#00FF1744" Offset="0" />
    <GradientStop Color="#4DFF1744" Offset="0.45" />
    <GradientStop Color="#00FF1744" Offset="1" />
  </LinearGradientBrush>

  <!-- A iluminação vermelha do rodape do painel. -->
  <RadialGradientBrush x:Key="PanelGlowGradient" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                       RadiusX="0.6" RadiusY="0.6">
    <GradientStop Color="#66FF1744" Offset="0" />
    <GradientStop Color="#26FF1744" Offset="0.45" />
    <GradientStop Color="#00FF1744" Offset="1" />
  </RadialGradientBrush>

  <!-- A iluminação suave do fundo da janela. -->
  <RadialGradientBrush x:Key="BackgroundGlowGradient" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                       RadiusX="0.75" RadiusY="0.75">
    <GradientStop Color="#331018" Offset="0" />
    <GradientStop Color="#140610" Offset="0.5" />
    <GradientStop Color="#00000000" Offset="1" />
  </RadialGradientBrush>

  <!-- O vinheta escura, para o texto continuar legivel. -->
  <RadialGradientBrush x:Key="VignetteGradient" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                       RadiusX="0.78" RadiusY="0.78">
    <GradientStop Color="#00000000" Offset="0.45" />
    <GradientStop Color="#99000000" Offset="1" />
  </RadialGradientBrush>

  <!-- A barra de progresso: vermelha com brilho. -->
  <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FF1744" Offset="0" />
    <GradientStop Color="#FF4A6B" Offset="0.5" />
    <GradientStop Color="#FF1744" Offset="1" />
  </LinearGradientBrush>

  <!-- A borda luminosa dos cards. -->
  <LinearGradientBrush x:Key="InfoCardBorderGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#3A6FA8" Offset="0" />
    <GradientStop Color="#1E3A5F" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="WarningCardBorderGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#C2183C" Offset="0" />
    <GradientStop Color="#6B1530" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SuccessCardBorderGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#2E9E5B" Offset="0" />
    <GradientStop Color="#1B5E3A" Offset="1" />
  </LinearGradientBrush>

  <!-- O brilho vermelho do logo e do botão. -->
  <SolidColorBrush x:Key="AccentRedGlowBrush" Color="#66FF1744" />
  <SolidColorBrush x:Key="SuccessGlowSoftBrush" Color="#4D22C55E" />

</ResourceDictionary>

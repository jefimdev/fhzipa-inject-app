<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ================================================================== -->
  <!-- Botoes                                                              -->
  <!-- ================================================================== -->

  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeButton}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- O botao principal: vermelho com gradiente e brilho. -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource ButtonRedGradient}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Effect" Value="{StaticResource ButtonGlow}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource CornerButton}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource ButtonRedHoverGradient}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource ButtonRedPressedGradient}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentRedLightBrush}" />
              <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
              <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- O botao escuro, com borda discreta. -->
  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="#141A24" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderHighlightBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource CornerButton}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#1C2431" />
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
              <Setter TargetName="Bg" Property="BorderBrush" Value="#46536B" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#0E131B" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentRedBrush}" />
              <Setter TargetName="Bg" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
              <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Foreground" Value="{StaticResource ErrorRedBrush}" />
  </Style>

  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ================================================================== -->
  <!-- Cartoes                                                             -->
  <!-- ================================================================== -->

  <Style x:Key="InstallerCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CornerCard}" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="InfoCard" TargetType="Border" BasedOn="{StaticResource InstallerCard}">
    <Setter Property="Background" Value="#0D1B2E" />
    <Setter Property="BorderBrush" Value="{StaticResource InfoCardBorderGradient}" />
  </Style>

  <Style x:Key="WarningCard" TargetType="Border" BasedOn="{StaticResource InstallerCard}">
    <Setter Property="Background" Value="#250A14" />
    <Setter Property="BorderBrush" Value="{StaticResource WarningCardBorderGradient}" />
  </Style>

  <Style x:Key="SuccessCard" TargetType="Border" BasedOn="{StaticResource InstallerCard}">
    <Setter Property="Background" Value="#0A1F16" />
    <Setter Property="BorderBrush" Value="{StaticResource SuccessCardBorderGradient}" />
  </Style>

  <Style x:Key="ProgressCard" TargetType="Border" BasedOn="{StaticResource InstallerCard}">
    <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderHighlightBrush}" />
  </Style>

  <!-- ================================================================== -->
  <!-- Barra de progresso                                                  -->
  <!-- O controle gerencia a largura do indicador pelos nomes             -->
  <!-- PART_Track e PART_Indicator.                                        -->
  <!-- ================================================================== -->

  <Style x:Key="InstallerProgressBar" TargetType="ProgressBar">
    <Setter Property="Height" Value="8" />
    <Setter Property="Foreground" Value="{StaticResource ProgressGradient}" />
    <Setter Property="Background" Value="#1E2735" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid x:Name="PART_Track" Background="Transparent" ClipToBounds="True">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="4"
                    Height="{TemplateBinding Height}"
                    SnapsToDevicePixels="True" />
            <Border x:Name="PART_Indicator"
                    Background="{TemplateBinding Foreground}"
                    CornerRadius="4"
                    Height="{TemplateBinding Height}"
                    HorizontalAlignment="Left"
                    SnapsToDevicePixels="True" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================== -->
  <!-- Campos                                                              -->
  <!-- ================================================================== -->

  <Style x:Key="InstallerTextBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource AccentRedBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource AccentRedBrush}" />
    <Setter Property="SelectionOpacity" Value="0.4" />
    <Setter Property="Background" Value="#0B1018" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="34" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bg"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource CornerField}"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Focusable="False"
                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentRedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
              <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="InstallerCheckBox" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                    Background="#0B1018"
                    BorderBrush="{StaticResource BorderHighlightBrush}"
                    BorderThickness="1"
                    VerticalAlignment="Center">
              <Path x:Name="Tick"
                    Data="M 2,6 L 5,9 L 10,2"
                    Stroke="{StaticResource BackgroundPrimaryBrush}"
                    StrokeThickness="1.8"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentRedBrush}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentRedBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentRedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================== -->
  <!-- Barras de rolagem e dicas                                          -->
  <!-- ================================================================== -->

  <Style TargetType="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#33FFFFFF" CornerRadius="3" Width="5" HorizontalAlignment="Center" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{StaticResource SurfaceElevatedBrush}"
                  BorderBrush="{StaticResource BorderHighlightBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="9,5">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBodySmall}" />
  </Style>

  <!-- ================================================================== -->
  <!-- Textos dentro dos cartoes                                           -->
  <!-- ================================================================== -->

  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="CardBody" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBodySmall}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="CardValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontDefault}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBodySmall}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

</ResourceDictionary>

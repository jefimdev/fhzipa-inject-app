{
  "Application": {
    "Name": "FHZIPA INJECT",
    "ExecutableName": "fhzipa-inject.exe",
    "Version": "1.0.0",
    "Description": "Instalador de aplicativos para iPhone.",
    "Publisher": "FHZIPA INJECT"
  },
  "Installer": {

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FHZIPA INJECT",
  "version": "1.0.0",
  "identifier": "app.fhzipa.inject",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FHZIPA INJECT",
        "width": 1600,
        "height": 960,
        "minHeight": 700,
        "minWidth": 1024,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "publisher": "FHZIPA INJECT",
    "copyright": "Copyright (C) 2025 nab138. Modified fork distributed under the MIT License.",
    "shortDescription": "Assistente de sideloading para iPhone e iPad",
    "longDescription": "FHZIPA INJECT instala arquivos IPA em iPhones e iPads, com autenticação Apple ID, pareamento, certificados e logs de diagnóstico.",
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
